APP_NAME=Enterprise GTM AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=replace-with-your-local-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_gtm_ai
# Optional hosted PostgreSQL URL; when set, it takes precedence over POSTGRES_*.
DATABASE_URL=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REQUIRED=false
SESSION_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
OUTBOUND_EMAIL_PROVIDER=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
EXOTEL_API_BASE_URL=https://api.in.exotel.com
# Public secure WebSocket base URL for Exotel media delivery, e.g. wss://your-tunnel.example
EXOTEL_PUBLIC_WS_BASE=
# Shared public secure WebSocket base for regional phone media streams (Twilio, etc.)
PHONE_PUBLIC_WS_BASE=
FRONTEND_URL=http://127.0.0.1:5176
# Comma-separated extra browser origins; use HTTPS origins only in production.
ADDITIONAL_CORS_ORIGINS=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
